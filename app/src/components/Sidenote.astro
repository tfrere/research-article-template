---
// Margin note for the element right before it. From 1280px it sits in the
// margin column of the page grid, next to that element; below it is shown
// inline. Styles in src/styles/layout/_sidenote.css.
---

<aside class="sidenote">
  <slot />
</aside>

<script>
  import { initSidenotes } from "../scripts/layout/sidenotes";
  initSidenotes();
</script>
